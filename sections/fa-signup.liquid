{%- comment -%}
  Felice sign-up — centred heading + intro and a first name / last name / email form with one button, on the tan
  membership texture. Blog page V1 "Gut Health E-book" (file B4QcctWXiG9ywP3uRA3coG, band 2719:19702,
  1440 x 674). Fields share the inquiry form's styles (fa-inquiry.css).
  The form is Shopify's customer form: the person becomes a customer with marketing consent and the tags below (e.g.
  to send the e-book with Shopify Email / Flow on that tag). The theme itself does not send the e-book.
  Layouts (E-Books V2, frame 2792:3796): "Image left" = hero 2792:3816 (cover 433 x 545 beside the form),
  "Email only" = "Not ready to download anything?" 2792:3891 (light band, one field with the button inside).
{%- endcomment -%}
{{ 'fa-inquiry.css' | asset_url | stylesheet_tag }}
{{ 'fa-signup.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign form_id = 'fa-signup-form-' | append: section.id
  assign bg = section.settings.background_asset
  assign layout = section.settings.layout | default: 'centered'
-%}
<section class="fa-section fa-signup fa-signup--{{ layout }}{% if section.settings.mobile_style == 'compact' %} fa-signup--mobile-compact{% endif %}{% if section.settings.show_botanicals %} fa-signup--botanicals{% endif %}" id="{{ section.settings.anchor_id | strip | remove_first: '#' | default: form_id }}"{% if section.settings.heading != blank %} aria-labelledby="fa-signup-title-{{ section.id }}"{% endif %}>
  {%- if section.settings.show_botanicals -%}
    {%- comment -%} E-Courses V1 2770:2777 / 2770:2822: the same chrysanthemum drawing twice, rising into the band above
      (top right) and hanging into the one below (bottom left), placed with Figma's own transforms. {%- endcomment -%}
    <div class="fa-signup__botanicals" aria-hidden="true">
      <div class="fa-signup__botanical-frame">
        <img class="fa-signup__botanical fa-signup__botanical--top" src="{{ 'fa-first-visit-botanical.png' | asset_url }}" width="544" height="852" loading="lazy" alt="">
        <span class="fa-signup__botanical fa-signup__botanical--bottom"><img src="{{ 'fa-first-visit-botanical.png' | asset_url }}" width="544" height="852" loading="lazy" alt=""></span>
      </div>
    </div>
  {%- endif -%}
  {%- if section.settings.background != blank or bg != blank -%}
    <div class="fa-bg" aria-hidden="true">
      {%- if section.settings.background != blank -%}
        {{ section.settings.background | image_url: width: 1920 | image_tag: widths: '750, 1100, 1440, 1920', sizes: '100vw', loading: 'lazy', alt: '' }}
      {%- else -%}
        {%- assign bg_2x = bg | replace: '.jpg', '-2x.jpg' -%}
        <img src="{{ bg | asset_url }}"{% if bg == 'fa-membership-bg.jpg' %} srcset="{{ bg | asset_url }} 1440w, {{ bg_2x | asset_url }} 2880w" sizes="100vw"{% endif %} width="1440" height="674" loading="lazy" alt="">
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="fa-container fa-signup__inner" data-fa-reveal="up" data-fa-reveal-stagger>
    {%- if layout == 'split' -%}
      <div class="fa-signup__media fa-media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 866 | image_tag: widths: '433, 866', sizes: '433px', loading: 'lazy', class: 'fa-signup__photo', alt: section.settings.image_alt }}
        {%- elsif section.settings.fallback_asset != blank -%}
          <img class="fa-signup__photo" src="{{ section.settings.fallback_asset | asset_url }}" width="866" height="1090" loading="lazy" alt="{{ section.settings.image_alt | escape }}">
        {%- endif -%}
      </div>
      <div class="fa-signup__column">
    {%- endif -%}
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="fa-signup__heading">
        {%- if section.settings.heading != blank -%}
          {%- assign h_tag = "h2" -%}{%- if section.settings.heading_h1 -%}{%- assign h_tag = "h1" -%}{%- endif -%}<{{ h_tag }} class="fa-signup__title" id="fa-signup-title-{{ section.id }}">{{ section.settings.heading | escape }}</{{ h_tag }}>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="fa-signup__text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- form 'customer', id: form_id, class: 'fa-signup__form' -%}
      <input type="hidden" name="contact[tags]" value="{{ section.settings.tags | escape }}">
      {%- if form.posted_successfully? -%}
        <p class="fa-inquiry__status" role="status" tabindex="-1" autofocus>{{ section.settings.success_message | escape }}</p>
      {%- elsif form.errors -%}
        <div class="fa-inquiry__status fa-inquiry__status--error" role="alert" tabindex="-1" autofocus>{{ form.errors | default_errors }}</div>
      {%- endif -%}
      {%- if layout == 'inline' -%}
        <div class="fa-signup__inline">
          <label class="visually-hidden" for="{{ form_id }}-email">{{ section.settings.email_placeholder | default: 'Email address' | escape }}</label>
          <input class="fa-signup__inline-input" type="email" id="{{ form_id }}-email" name="contact[email]" placeholder="{{ section.settings.email_placeholder | default: 'Email address' | escape }}" autocomplete="email" spellcheck="false" autocapitalize="off" required{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
          <button type="submit" class="fa-btn fa-btn--primary fa-signup__submit">{{ section.settings.button_label | default: 'Sign me up' | escape }}</button>
        </div>
      {%- else -%}
      <div class="fa-inquiry__fields">
        <div class="fa-inquiry__row">
          <div class="fa-inquiry__field">
            <label class="fa-inquiry__label" for="{{ form_id }}-first">First name*</label>
            <input class="fa-inquiry__input" type="text" id="{{ form_id }}-first" name="contact[first_name]" autocomplete="given-name" required>
          </div>
          <div class="fa-inquiry__field">
            <label class="fa-inquiry__label" for="{{ form_id }}-last">Last name*</label>
            <input class="fa-inquiry__input" type="text" id="{{ form_id }}-last" name="contact[last_name]" autocomplete="family-name" required>
          </div>
        </div>
        <div class="fa-inquiry__field">
          <label class="fa-inquiry__label" for="{{ form_id }}-email">Email*</label>
          <input class="fa-inquiry__input" type="email" id="{{ form_id }}-email" name="contact[email]" autocomplete="email" spellcheck="false" autocapitalize="off" required{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
        </div>
      </div>
      <button type="submit" class="fa-btn fa-btn--primary fa-signup__submit">{{ section.settings.button_label | default: 'Sign me up' | escape }}</button>
      {%- endif -%}
    {%- endform -%}
    {%- if layout == 'split' -%}</div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Felice sign-up form",
  "tag": "div",
  "class": "fa-signup-section",
  "settings": [
    { "type": "checkbox", "id": "heading_h1", "label": "Heading is the page title (H1)", "info": "Turn on when this section opens the page.", "default": false },
    {
      "type": "select",
      "id": "mobile_style",
      "label": "Mobile style",
      "options": [
        { "value": "standard", "label": "Standard" },
        { "value": "compact", "label": "Compact (Blog page mobile)" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "centered", "label": "Centred: name + email fields" },
        { "value": "split", "label": "Image left, form right" },
        { "value": "inline", "label": "Email only, button in the field" }
      ],
      "default": "centered"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gut Health E-book" },
    { "type": "richtext", "id": "text", "label": "Intro" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign me up" },
    { "type": "text", "id": "tags", "label": "Customer tags", "default": "newsletter, ebook-gut-health", "info": "Added to everyone who signs up (comma separated). Keep \"newsletter\" for email marketing." },
    { "type": "text", "id": "success_message", "label": "Thank-you message", "default": "Thank you! Check your inbox for the e-book." },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder (email-only layout)", "default": "Email address" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" },
    { "type": "header", "content": "Image (image left layout)" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "fallback_asset", "label": "Fallback image (bundled file)", "default": "fa-signup-ebook-cover.jpg" },
    { "type": "text", "id": "image_alt", "label": "Image description" },
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "background", "label": "Background image" },
    { "type": "text", "id": "background_asset", "label": "Bundled background file", "default": "fa-membership-bg.jpg" },
    { "type": "checkbox", "id": "show_botanicals", "label": "Show botanicals (desktop)", "info": "Two flower drawings overlapping the bands above and below (E-Courses design).", "default": false }
  ],
  "presets": [
    { "name": "Felice sign-up form" }
  ]
}
{% endschema %}
