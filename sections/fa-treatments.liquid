{%- comment -%}
  Felice treatments — "Rooted in expertise": centred heading and alternating photo / text rows, one per treatment
  (title, price + duration, optional uppercase lead line, text, booking button), on a moss botanical texture.
  Figma (services page, 394:3071): background 394:3465, content 394:3466 (heading 394:3467, rows 394:3474);
  the Chinese characters are rasters centred on each photo (394:3552, 394:3553, 394:3512, 394:3516, 394:3538, 394:3542).
  v2 (file B4QcctWXiG9ywP3uRA3coG, frame 2263:2286): background 2263:2686, content 2263:2687, rows 2263:2695, botanical
  2263:2857 (owned here: it rises into the service menu band above). Mobile frame 2264:6705: background 2264:8016,
  rows 2264:8131 …, botanical 2265:8321; no eyebrow on mobile.
  V5 desktop (frame 2669:28405, band 2669:28492, content 2669:28493, rows 2669:28502 …): 500px rows, linen price tags
  (block "Price tags"), Marisa lead line; no V5 mobile frame, so mobile keeps the v2 layout.
  Desktop / tablet (900+): photo + text side by side, the photo alternating left (odd rows) / right (even rows).
  Mobile (<= 899): each row stacks photo (351 x 292) then text.
  Each row gets id="treatment-<handle>" so "Jump to a treatment" cards can link to #treatment-<handle>.
{%- endcomment -%}
{{ 'fa-treatments.css' | asset_url | stylesheet_tag }}

<section class="fa-section fa-treatments{% if section.settings.mobile_style == 'compact' %} fa-treatments--mobile-compact{% endif %}" id="fa-treatments-{{ section.id }}"{% if section.settings.heading != blank %} aria-labelledby="fa-treatments-title-{{ section.id }}"{% endif %}>
  <div class="fa-bg" aria-hidden="true">
    {%- comment -%}
      Mobile (<= 899) has its own Figma texture crop (2264:8016, moss 80%); a picked desktop image is used on mobile too
      unless a mobile image is picked.
    {%- endcomment -%}
    <picture>
      {%- if section.settings.background_mobile != blank -%}
        <source media="(max-width: 899px)" srcset="{{ section.settings.background_mobile | image_url: width: 750 }} 750w, {{ section.settings.background_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">
      {%- elsif section.settings.background == blank -%}
        <source media="(max-width: 899px)" srcset="{{ 'fa-treatments-bg-mobile.jpg' | asset_url }}" width="750" height="7824">
      {%- endif -%}
      {%- if section.settings.background != blank -%}
        {{ section.settings.background | image_url: width: 1920 | image_tag: widths: '750, 1100, 1440, 1920', sizes: '100vw', loading: 'lazy', alt: '' }}
      {%- else -%}
        <img src="{{ 'fa-treatments-bg.jpg' | asset_url }}" alt="" width="1440" height="3241" loading="lazy">
      {%- endif -%}
    </picture>
  </div>
  {%- if section.settings.botanical -%}
    <img class="fa-deco fa-treatments__botanical" src="{{ 'fa-first-visit-botanical.png' | asset_url }}" width="544" height="852" loading="lazy" alt="" aria-hidden="true">
  {%- endif -%}

  <div class="fa-container fa-treatments__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="fa-heading fa-treatments__heading" data-fa-reveal="up" data-fa-reveal-stagger>
        {% render 'fa-eyebrow', text: section.settings.eyebrow, class: 'fa-treatments__eyebrow', tone: 'light' %}
        {%- if section.settings.heading != blank -%}
          <h2 class="fa-heading__title fa-treatments__title-main" id="fa-treatments-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="fa-heading__text fa-treatments__intro">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="fa-treatments__list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign handle = block.settings.handle | handleize
            if handle == blank
              assign handle = block.id | handleize
            endif
            comment
              Keep an em dash on the line of the word before it (no dash alone at the start of a line).
            endcomment
            assign title = block.settings.title | strip | escape | replace: ' —', '&nbsp;—'
            assign button_link = block.settings.button_link | default: section.settings.booking_link | default: '#'
          -%}
          <article class="fa-treatments__row" id="treatment-{{ handle }}" data-fa-reveal="up" data-fa-reveal-stagger style="--fa-tr-shade: {{ block.settings.shade | divided_by: 100.0 }}; --fa-tr-shade-m: {{ block.settings.shade_mobile | default: block.settings.shade | divided_by: 100.0 }}; --fa-tr-glyph-h: {{ block.settings.glyph_height }}; --fa-tr-glyph-h-m: {{ block.settings.glyph_height_mobile | default: 81 }}; --fa-tr-glyph-x: {{ block.settings.glyph_x | default: 0 }}; --fa-tr-glyph-y: {{ block.settings.glyph_y | default: 0 }}; --fa-tr-text-lh: {{ block.settings.text_line_height | default: 26 }}px; --fa-tr-p-gap: {{ block.settings.paragraph_gap | default: 24 }}px; --fa-tr-copy-gap: {{ block.settings.copy_gap | default: 32 }}px;" {{ block.shopify_attributes }}>
            <div class="fa-treatments__media fa-media">
              {%- if block.settings.image != blank -%}
                {%- liquid
                  assign focal = block.settings.image.presentation.focal_point | default: 'center'
                  assign focal_style = '--fa-tr-focal: ' | append: focal
                -%}
                {{ block.settings.image | image_url: width: 1400 | image_tag: widths: '375, 560, 700, 1050, 1400', sizes: '(min-width: 1440px) 683px, (min-width: 1100px) calc((100vw - 158px) * 0.533), (min-width: 900px) calc((100vw - 104px) * 0.533), min(100vw - 24px, 560px)', loading: 'lazy', alt: block.settings.image.alt | default: '', class: 'fa-treatments__photo', style: focal_style }}
              {%- elsif block.settings.fallback_asset != blank -%}
                {%- if block.settings.fallback_asset_mobile != blank -%}
                  <picture>
                    <source media="(max-width: 899px)" srcset="{{ block.settings.fallback_asset_mobile | asset_url }}">
                    <img class="fa-treatments__photo" src="{{ block.settings.fallback_asset | asset_url }}" alt="" width="280" height="178" loading="lazy">
                  </picture>
                {%- else -%}
                  <img class="fa-treatments__photo" src="{{ block.settings.fallback_asset | asset_url }}" alt="" width="280" height="178" loading="lazy">
                {%- endif -%}
              {%- endif -%}
              {%- if block.settings.glyph_image != blank -%}
                {{ block.settings.glyph_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '', class: 'fa-treatments__glyph' }}
              {%- elsif block.settings.glyph_asset != blank -%}
                {%- liquid
                  comment
                    width / height = the file's intrinsic size (the aspect ratio before it loads); CSS sets the rendered
                    height and the width follows the file. Bundled PNGs are listed; another file falls back to two
                    stacked characters (1:2).
                  endcomment
                  case block.settings.glyph_asset
                    when 'fa-treatments-glyph-acupuncture.png'
                      assign glyph_w = 61
                      assign glyph_h = 133
                    when 'fa-treatments-glyph-cosmetic-acupuncture.png'
                      assign glyph_w = 160
                      assign glyph_h = 266
                    when 'fa-treatments-glyph-cupping.png'
                      assign glyph_w = 60
                      assign glyph_h = 126
                    when 'fa-treatments-glyph-tui-na-massage.png'
                      assign glyph_w = 65
                      assign glyph_h = 141
                    when 'fa-treatments-glyph-contrast-therapy.png'
                      assign glyph_w = 79
                      assign glyph_h = 113
                    when 'fa-treatments-glyph-herbal-wellness.png'
                      assign glyph_w = 42
                      assign glyph_h = 115
                    else
                      assign glyph_h = block.settings.glyph_height
                      assign glyph_w = glyph_h | divided_by: 2
                  endcase
                -%}
                <img class="fa-treatments__glyph" src="{{ block.settings.glyph_asset | asset_url }}" alt="" aria-hidden="true" width="{{ glyph_w }}" height="{{ glyph_h }}" loading="lazy">
              {%- elsif block.settings.characters != blank -%}
                <span class="fa-treatments__glyph fa-treatments__glyph--text" lang="zh-Hans" aria-hidden="true">{{ block.settings.characters | escape }}</span>
              {%- endif -%}
            </div>

            <div class="fa-treatments__body">
              {%- liquid
                assign price_tags = block.settings.price_tags | strip | escape | newline_to_br | split: '<br />'
              -%}
              {%- if title != blank or block.settings.price != blank or price_tags.size > 0 -%}
                <div class="fa-treatments__head">
                  {%- if title != blank -%}
                    <h3 class="fa-treatments__title">{{ title | newline_to_br }}</h3>
                  {%- endif -%}
                  {%- if price_tags.size > 0 -%}
                    <ul class="fa-treatments__tags{% if block.settings.price_tags_compact %} fa-treatments__tags--compact{% endif %}" role="list">
                      {%- for tag in price_tags -%}
                        {%- assign tag_text = tag | strip -%}
                        {%- if tag_text != blank -%}<li class="fa-treatments__tag">{{ tag_text | replace: '·', '<span class="fa-treatments__dot">·</span>' }}</li>{%- endif -%}
                      {%- endfor -%}
                    </ul>
                  {%- elsif block.settings.price != blank -%}
                    <p class="fa-treatments__price">{{ block.settings.price | escape }}</p>
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- if block.settings.lead != blank or block.settings.text != blank -%}
                <div class="fa-treatments__copy">
                  {%- if block.settings.lead != blank -%}
                    <p class="fa-treatments__lead">{{ block.settings.lead | escape }}</p>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="fa-treatments__text">{{ block.settings.text }}</div>
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <a href="{{ button_link }}"{% render 'fa-link-target', url: button_link %} class="fa-btn fa-btn--light fa-treatments__button{% if block.settings.button_compact_mobile %} fa-treatments__button--compact{% endif %}">{{ block.settings.button_label | escape }}</a>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Felice treatments",
  "tag": "div",
  "class": "fa-treatments-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "select",
      "id": "mobile_style",
      "label": "Mobile style",
      "options": [
        { "value": "standard", "label": "Standard" },
        { "value": "compact", "label": "Compact (In-Clinic Services mobile)" }
      ],
      "default": "standard"
    },
    {
      "type": "image_picker",
      "id": "background",
      "label": "Background texture",
      "info": "Optional. Uses the bundled moss botanical texture when empty."
    },
    {
      "type": "image_picker",
      "id": "background_mobile",
      "label": "Background texture (mobile)",
      "info": "Optional, screens up to 899px. Without it, mobile uses the desktop image you picked, or the bundled mobile texture."
    },
    {
      "type": "checkbox",
      "id": "botanical",
      "label": "Show botanical",
      "info": "Chrysanthemum at the top right, rising into the section above.",
      "default": false
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Desktop and tablet only (the mobile design has none).",
      "default": "Our team"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Rooted in expertise. Personal in every detail."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Our practitioners offer diverse specialties and treatment styles rooted in Traditional Chinese Medicine. We focus on understanding the deeper patterns that affect your well-being, rather than just treating symptoms.</p>"
    },
    {
      "type": "url",
      "id": "booking_link",
      "label": "Booking link",
      "info": "Used by every treatment button without its own link (e.g. your Jane App page)."
    }
  ],
  "blocks": [
    {
      "type": "treatment",
      "name": "Treatment",
      "settings": [
        {
          "type": "text",
          "id": "handle",
          "label": "Anchor handle",
          "info": "The row gets id \"treatment-<handle>\", so links to #treatment-<handle> scroll here (e.g. acupuncture, cupping)."
        },
        {
          "type": "header",
          "content": "Photo"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Shown at 683 x 434 on desktop."
        },
        {
          "type": "text",
          "id": "fallback_asset",
          "label": "Fallback theme asset",
          "info": "Theme asset filename shown when no image is picked."
        },
        {
          "type": "text",
          "id": "fallback_asset_mobile",
          "label": "Fallback theme asset (mobile)",
          "info": "Optional theme asset filename for screens up to 899px when no image is picked (mobile photo 351 x 292)."
        },
        {
          "type": "range",
          "id": "shade",
          "label": "Photo shade",
          "min": 0,
          "max": 50,
          "step": 5,
          "unit": "%",
          "default": 10
        },
        {
          "type": "range",
          "id": "shade_mobile",
          "label": "Photo shade (mobile)",
          "min": 0,
          "max": 50,
          "step": 5,
          "unit": "%",
          "default": 10
        },
        {
          "type": "image_picker",
          "id": "glyph_image",
          "label": "Chinese characters image",
          "info": "Transparent PNG centred on the photo."
        },
        {
          "type": "text",
          "id": "glyph_asset",
          "label": "Fallback characters asset",
          "info": "Theme asset filename used when no characters image is picked."
        },
        {
          "type": "text",
          "id": "characters",
          "label": "Chinese characters (text)",
          "info": "Shown as text when there is no characters image."
        },
        {
          "type": "range",
          "id": "glyph_height",
          "label": "Characters height (desktop)",
          "info": "Scales with the photo on smaller screens.",
          "min": 80,
          "max": 180,
          "step": 1,
          "unit": "px",
          "default": 133
        },
        {
          "type": "range",
          "id": "glyph_x",
          "label": "Characters offset right (desktop)",
          "info": "From the photo centre; negative moves left. Scales with the photo; mobile centres the characters.",
          "min": -25,
          "max": 25,
          "step": 0.5,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "glyph_y",
          "label": "Characters offset down (desktop)",
          "info": "From the photo centre; negative moves up. Scales with the photo; mobile centres the characters.",
          "min": -25,
          "max": 25,
          "step": 0.5,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "glyph_height_mobile",
          "label": "Characters height (mobile)",
          "info": "On the 351 x 292 mobile photo; scales with the photo on wider phones.",
          "min": 50,
          "max": 120,
          "step": 1,
          "unit": "px",
          "default": 81
        },
        {
          "type": "header",
          "content": "Text"
        },
        {
          "type": "textarea",
          "id": "title",
          "label": "Title",
          "info": "Line breaks are kept."
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price and duration"
        },
        {
          "type": "textarea",
          "id": "price_tags",
          "label": "Price tags",
          "info": "One linen tag per line (e.g. Initial visit  ·  75 min  ·  $250). Replaces the price line when filled in."
        },
        {
          "type": "checkbox",
          "id": "price_tags_compact",
          "label": "Tighter price tags",
          "info": "Less padding and tracking, so a long tag stays on one line.",
          "default": false
        },
        {
          "type": "text",
          "id": "lead",
          "label": "Lead line",
          "info": "Optional uppercase line above the text."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "range",
          "id": "text_line_height",
          "label": "Text line height (desktop)",
          "min": 20,
          "max": 32,
          "step": 1,
          "unit": "px",
          "default": 26
        },
        {
          "type": "range",
          "id": "paragraph_gap",
          "label": "Space between paragraphs",
          "min": 0,
          "max": 60,
          "step": 1,
          "unit": "px",
          "default": 24,
          "info": "Desktop. Figma V5: 24 (Herbal Wellness 41, a blank line)."
        },
        {
          "type": "range",
          "id": "copy_gap",
          "label": "Space above the text",
          "min": 16,
          "max": 48,
          "step": 1,
          "unit": "px",
          "default": 32,
          "info": "Desktop, between the price tags and the text. Figma V5: 32 (Cupping 24, Herbal Wellness 36)."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Book now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link",
          "info": "Defaults to the section's booking link."
        },
        {
          "type": "checkbox",
          "id": "button_compact_mobile",
          "label": "Compact button on mobile",
          "info": "Tighter side padding and tracking so a long label stays on one line (Figma: last row).",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Felice treatments",
      "blocks": [
        {
          "type": "treatment",
          "settings": {
            "handle": "acupuncture",
            "fallback_asset": "fa-treatments-acupuncture.jpg",
            "glyph_asset": "fa-treatments-glyph-acupuncture.png",
            "characters": "针刺",
            "title": "Acupuncture",
            "price": "$200 - $300 - 60 minutes",
            "button_label": "Book acupuncture"
          }
        },
        {
          "type": "treatment",
          "settings": {
            "handle": "cupping",
            "fallback_asset": "fa-treatments-cupping.jpg",
            "glyph_asset": "fa-treatments-glyph-cupping.png",
            "glyph_height": 126,
            "characters": "拔罐",
            "title": "Cupping",
            "price": "$200 - $300 - 60 minutes",
            "button_label": "Book cupping"
          }
        }
      ]
    }
  ]
}
{% endschema %}
