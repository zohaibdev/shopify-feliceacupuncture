{%- comment -%}
  Felice inquiry — "Ready to begin?": intro, contact links and a numbered "what happens next" panel on the left, the
  New Patient Inquiry Form on the right, on a moss texture.
  Figma: Concierge page V1 (file B4QcctWXiG9ywP3uRA3coG, frame 2644:15168), band 2644:17794 (1440 x 1000).
  The form is Shopify's contact form: submissions are emailed to the store's sender address (Settings > Notifications),
  every field arrives as a labelled line. Options of "I'm interested in" come from the live site's form.
  No mobile frame: the columns stack below 1100px.
{%- endcomment -%}
{{ 'fa-inquiry.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign form_id = 'fa-inquiry-form-' | append: section.id
  assign interests = section.settings.interest_options | strip | escape | newline_to_br | split: '<br />'
  assign recipients = section.settings.for_options | strip | escape | newline_to_br | split: '<br />'
  assign bg = section.settings.background_asset
-%}
<section class="fa-section fa-inquiry{% if section.settings.mobile_style == 'compact' %} fa-inquiry--mobile-compact{% endif %}" id="{{ section.settings.anchor_id | strip | remove_first: '#' | default: form_id }}"{% if section.settings.heading != blank %} aria-labelledby="fa-inquiry-title-{{ section.id }}"{% endif %}>
  {%- if section.settings.background != blank or bg != blank -%}
    <div class="fa-bg" aria-hidden="true">
      {%- if section.settings.background != blank -%}
        {{ section.settings.background | image_url: width: 1920 | image_tag: widths: '750, 1100, 1440, 1920', sizes: '100vw', loading: 'lazy', alt: '' }}
      {%- else -%}
        <img src="{{ bg | asset_url }}" width="1440" height="1000" loading="lazy" alt="">
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="fa-container fa-inquiry__inner">
    <div class="fa-inquiry__aside" data-fa-reveal="up" data-fa-reveal-stagger>
      <div class="fa-inquiry__intro">
        {%- if section.settings.heading != blank -%}
          <h2 class="fa-inquiry__title" id="fa-inquiry-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="fa-inquiry__text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      <div class="fa-inquiry__extra">
        {%- if section.settings.contact_title != blank or section.settings.email != blank or section.settings.phone_label != blank -%}
          <div class="fa-inquiry__contact">
            {%- if section.settings.contact_title != blank -%}
              <p class="fa-inquiry__contact-title">{{ section.settings.contact_title | escape }}</p>
            {%- endif -%}
            <ul class="fa-inquiry__links" role="list">
              {%- if section.settings.email != blank -%}
                <li><a class="fa-inquiry__link" href="mailto:{{ section.settings.email | strip }}">{% render 'fa-icons-footer', icon: 'mail' %}<span>{{ section.settings.email | escape }}</span></a></li>
              {%- endif -%}
              {%- if section.settings.phone_label != blank -%}
                <li>
                  {%- if section.settings.phone_link != blank -%}
                    <a class="fa-inquiry__link" href="{{ section.settings.phone_link }}">{% render 'fa-icons-footer', icon: 'phone' %}<span>{{ section.settings.phone_label | escape }}</span></a>
                  {%- else -%}
                    <span class="fa-inquiry__link">{% render 'fa-icons-footer', icon: 'phone' %}<span>{{ section.settings.phone_label | escape }}</span></span>
                  {%- endif -%}
                </li>
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="fa-inquiry__steps">
            {%- if section.settings.steps_title != blank -%}
              <h3 class="fa-inquiry__steps-title">{{ section.settings.steps_title | escape }}</h3>
            {%- endif -%}
            <ol class="fa-inquiry__step-list" role="list">
              {%- for block in section.blocks -%}
                <li class="fa-inquiry__step" {{ block.shopify_attributes }}>
                  <span class="fa-inquiry__step-number" aria-hidden="true">{{ forloop.index }}</span>
                  <span class="fa-inquiry__step-text">{{ block.settings.text | escape | newline_to_br }}</span>
                </li>
              {%- endfor -%}
            </ol>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="fa-inquiry__panel" data-fa-reveal="up">
      {%- form 'contact', id: form_id, class: 'fa-inquiry__form' -%}
        <input type="hidden" name="contact[form]" value="{{ section.settings.form_name | escape }}">
        {%- if form.posted_successfully? -%}
          <p class="fa-inquiry__status" role="status" tabindex="-1" autofocus>{{ section.settings.success_message | escape }}</p>
        {%- elsif form.errors -%}
          <div class="fa-inquiry__status fa-inquiry__status--error" role="alert" tabindex="-1" autofocus>{{ form.errors | default_errors }}</div>
        {%- endif -%}

        <div class="fa-inquiry__fields">
          <div class="fa-inquiry__row">
            <div class="fa-inquiry__field">
              <label class="fa-inquiry__label" for="{{ form_id }}-first">First name*</label>
              <input class="fa-inquiry__input" type="text" id="{{ form_id }}-first" name="contact[first_name]" autocomplete="given-name" required value="{{ form.first_name }}">
            </div>
            <div class="fa-inquiry__field">
              <label class="fa-inquiry__label" for="{{ form_id }}-last">Last name*</label>
              <input class="fa-inquiry__input" type="text" id="{{ form_id }}-last" name="contact[last_name]" autocomplete="family-name" required value="{{ form.last_name }}">
            </div>
          </div>
          <div class="fa-inquiry__row">
            <div class="fa-inquiry__field">
              <label class="fa-inquiry__label" for="{{ form_id }}-email">Email*</label>
              <input class="fa-inquiry__input" type="email" id="{{ form_id }}-email" name="contact[email]" autocomplete="email" spellcheck="false" autocapitalize="off" required value="{{ form.email }}"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
            </div>
            <div class="fa-inquiry__field">
              <label class="fa-inquiry__label" for="{{ form_id }}-phone">Phone*</label>
              <input class="fa-inquiry__input" type="tel" id="{{ form_id }}-phone" name="contact[phone]" autocomplete="tel" inputmode="tel" pattern="[0-9+\(\)\-.\s]{7,20}" title="Phone number: digits, spaces and + ( ) - . only" required value="{{ form.phone }}">
            </div>
          </div>
          {%- if interests.size > 0 -%}
            <div class="fa-inquiry__field">
              <label class="fa-inquiry__label" for="{{ form_id }}-interest">{{ section.settings.interest_label | escape }}</label>
              <div class="fa-inquiry__select">
                <select class="fa-inquiry__input" id="{{ form_id }}-interest" name="contact[interested_in]" required>
                  <option value="" disabled selected>Select an option</option>
                  {%- for option in interests -%}
                    {%- assign option_text = option | strip -%}
                    {%- if option_text != blank -%}<option value="{{ option_text }}">{{ option_text }}</option>{%- endif -%}
                  {%- endfor -%}
                </select>
                <svg class="fa-inquiry__chevron" viewBox="0 0 15 8" width="15" height="8" aria-hidden="true" focusable="false"><path fill="currentColor" d="M0 1.257 7.5 8 15 1.257 13.602 0 7.5 5.486 1.398 0Z"/></svg>
              </div>
            </div>
          {%- endif -%}
          <div class="fa-inquiry__field fa-inquiry__field--message">
            <label class="fa-inquiry__label" for="{{ form_id }}-message">{{ section.settings.message_label | escape }}</label>
            <textarea class="fa-inquiry__input fa-inquiry__textarea" id="{{ form_id }}-message" name="contact[body]" rows="5">{{ form.body }}</textarea>
          </div>
          {%- if recipients.size > 0 -%}
            <fieldset class="fa-inquiry__field fa-inquiry__choices">
              <legend class="fa-inquiry__label fa-inquiry__label--wide">{{ section.settings.for_label | escape }}</legend>
              <div class="fa-inquiry__options">
                {%- for option in recipients -%}
                  {%- assign option_text = option | strip -%}
                  {%- if option_text != blank -%}
                    <label class="fa-inquiry__option">
                      <input type="radio" name="contact[inquiring_for]" value="{{ option_text }}"{% if forloop.first %} checked{% endif %}>
                      <span>{{ option_text }}</span>
                    </label>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endif -%}
        </div>

        <button type="submit" class="fa-btn fa-btn--primary fa-inquiry__submit">{{ section.settings.button_label | default: 'Send' | escape }}</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Felice inquiry form",
  "tag": "div",
  "class": "fa-inquiry-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "mobile_style",
      "label": "Mobile style",
      "options": [
        { "value": "standard", "label": "Standard" },
        { "value": "compact", "label": "Compact (Concierge mobile)" }
      ],
      "default": "standard"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready to begin?" },
    { "type": "richtext", "id": "text", "label": "Intro" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "info": "Lets a link jump to the form, e.g. inquiry for #inquiry." },
    { "type": "header", "content": "Contact" },
    { "type": "text", "id": "contact_title", "label": "Contact title", "default": "Prefer to talk?" },
    { "type": "text", "id": "email", "label": "Email address" },
    { "type": "text", "id": "phone_label", "label": "Phone label" },
    { "type": "text", "id": "phone_link", "label": "Phone link", "info": "e.g. tel:+14244780019" },
    { "type": "header", "content": "Next steps panel" },
    { "type": "text", "id": "steps_title", "label": "Panel title", "default": "What happens after you submit" },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "form_name", "label": "Form name in the email", "default": "New Patient Inquiry" },
    { "type": "text", "id": "interest_label", "label": "Interest label", "default": "I’m interested in...*" },
    { "type": "textarea", "id": "interest_options", "label": "Interest options", "info": "One per line; the first is preselected." },
    { "type": "text", "id": "message_label", "label": "Message label", "default": "Briefly describe your reason for seeking treatment" },
    { "type": "text", "id": "for_label", "label": "\"Inquiring for\" label", "default": "I’m inquiring for..." },
    { "type": "textarea", "id": "for_options", "label": "\"Inquiring for\" options", "info": "One per line; the first is preselected." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Schedule your visit" },
    { "type": "text", "id": "success_message", "label": "Thank-you message", "default": "Thank you. We received your inquiry and will reach out within a few days." },
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "background", "label": "Background image" },
    { "type": "text", "id": "background_asset", "label": "Bundled background file", "default": "fa-inquiry-bg.jpg", "info": "Theme asset used when no image is picked." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Next step",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Text", "info": "A line break is kept (Figma breaks some steps by hand)." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Felice inquiry form",
      "settings": {
        "interest_options": "In-Home Concierge Care\nVirtual Concierge Care",
        "for_options": "Myself\nMy child or dependent\nSomeone else"
      }
    }
  ]
}
{% endschema %}
