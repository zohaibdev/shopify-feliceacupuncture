{%- comment -%}
  Felice glyph columns — centred heading + intro, a row of columns (a coloured Chinese character, a title in the same
  colour, a short text) and an optional note bar below.
  Figma: Our Approach V3 "Our philosophy" (file B4QcctWXiG9ywP3uRA3coG, band 2669:35822, content 2669:35825).
  The characters are raster masks in Figma: blocks take a light-on-transparent image (or a bundled mask file) that is
  painted in the column colour.
  Style "Numbered" (Concierge page V1 "What your membership includes", frame 2644:15168, content 2644:17793): left-aligned
  columns with a big number, a clay rule, the title and a check list (block "Check list", one line per item); an
  optional botanical rising into the band above.
{%- endcomment -%}

{{ 'fa-glyph-columns.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign default_id = 'fa-glyph-columns-' | append: section.id
  assign title_id = 'fa-glyph-columns-title-' | append: section.id
  assign bg = section.settings.background_asset
  assign style = section.settings.style | default: 'glyph'
-%}
<section
  class="fa-section fa-glyph-columns fa-glyph-columns--{{ style }}{% if section.settings.mobile_style == 'compact' %} fa-glyph-columns--mobile-compact{% endif %}"
  id="{{ section.settings.anchor_id | strip | remove_first: '#' | default: default_id }}"
  style="--fa-gc-pad-top: {{ section.settings.padding_top }}px; --fa-gc-pad-bottom: {{ section.settings.padding_bottom }}px;"
  {%- if section.settings.heading != blank %} aria-labelledby="{{ title_id }}"{% endif %}
>
  {%- if section.settings.background != blank or bg != blank -%}
    <div class="fa-bg" aria-hidden="true">
      {%- if section.settings.background != blank -%}
        {{ section.settings.background | image_url: width: 1920 | image_tag: widths: '750, 1100, 1440, 1920', sizes: '100vw', loading: 'lazy', alt: '' }}
      {%- else -%}
        <img src="{{ bg | asset_url }}" width="1440" height="658" loading="lazy" alt="">
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.settings.botanical == 'rising_right' -%}
    <img class="fa-deco fa-glyph-columns__botanical" src="{{ 'fa-concierge-botanical-right.png' | asset_url }}" width="216" height="383" loading="lazy" alt="" aria-hidden="true">
  {%- endif -%}
  <div class="fa-container fa-glyph-columns__inner">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="fa-heading fa-glyph-columns__heading" data-fa-reveal="up" data-fa-reveal-stagger>
        {%- if section.settings.heading != blank -%}
          <h2 class="fa-heading__title fa-glyph-columns__title" id="{{ title_id }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="fa-heading__text fa-glyph-columns__intro">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="fa-glyph-columns__list" role="list" data-fa-reveal="up" data-fa-reveal-stagger>
        {%- for block in section.blocks -%}
          {%- liquid
            assign glyph_url = blank
            if block.settings.glyph_image != blank
              assign glyph_url = block.settings.glyph_image | image_url: width: 300
            elsif block.settings.glyph_asset != blank
              assign glyph_url = block.settings.glyph_asset | asset_url
            endif
          -%}
          <li class="fa-glyph-columns__item" style="--fa-gc-color: {{ block.settings.color }}; --fa-gc-w: {{ block.settings.width }}px;" {{ block.shopify_attributes }}>
            {%- if block.settings.number != blank -%}
              <p class="fa-glyph-columns__number" aria-hidden="true">{{ block.settings.number | escape }}</p>
            {%- endif -%}
            {%- if glyph_url != blank -%}
              <span class="fa-glyph-columns__glyph" style="--fa-gc-glyph: url('{{ glyph_url }}');" aria-hidden="true"></span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="fa-glyph-columns__item-title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="fa-glyph-columns__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
            {%- if block.settings.items != blank -%}
              {%- assign lines = block.settings.items | strip | escape | newline_to_br | split: '<br />' -%}
              <ul class="fa-glyph-columns__checks" role="list">
                {%- for line in lines -%}
                  {%- assign line_text = line | strip -%}
                  {%- if line_text != blank -%}<li class="fa-glyph-columns__check"><span>{{ line_text }}</span></li>{%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <p class="fa-glyph-columns__note" data-fa-reveal="fade">{{ section.settings.note | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Felice glyph columns",
  "tag": "div",
  "class": "fa-glyph-columns-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "select",
      "id": "mobile_style",
      "label": "Mobile style",
      "options": [
        { "value": "standard", "label": "Standard" },
        { "value": "compact", "label": "Compact (Our Approach mobile)" }
      ],
      "default": "standard"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note below the columns",
      "info": "Shown in a light bar. Leave blank to hide it."
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "glyph", "label": "Characters, centred" },
        { "value": "numbered", "label": "Numbers and check lists, left-aligned" }
      ],
      "default": "glyph"
    },
    {
      "type": "select",
      "id": "botanical",
      "label": "Botanical",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "rising_right", "label": "Right, rising into the band above" }
      ],
      "default": "none"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Lets a link jump to this section, e.g. philosophy for #philosophy."
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "background_asset",
      "label": "Bundled background file",
      "default": "fa-glyph-columns-bg.jpg",
      "info": "Theme asset used when no image is picked. Blank shows the plain colour."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 40,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 40,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 130
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "info": "Numbered style, e.g. 01."
        },
        {
          "type": "image_picker",
          "id": "glyph_image",
          "label": "Character image",
          "info": "Square artwork on a transparent background; it is painted in the colour below (99 x 99)."
        },
        {
          "type": "text",
          "id": "glyph_asset",
          "label": "Bundled character file",
          "info": "Theme asset used when no image is picked, e.g. fa-glyph-columns-jing.png."
        },
        {
          "type": "color",
          "id": "color",
          "label": "Colour",
          "default": "#922039"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Qi · vitality"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "textarea",
          "id": "items",
          "label": "Check list",
          "info": "One item per line, shown with a check mark."
        },
        {
          "type": "range",
          "id": "width",
          "label": "Column width (desktop)",
          "min": 280,
          "max": 420,
          "step": 2,
          "unit": "px",
          "default": 354
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Felice glyph columns",
      "settings": {
        "heading": "Our philosophy",
        "text": "<p>At Felice Acupuncture, we help our patients find their innate abilities to heal.</p>"
      },
      "blocks": [
        { "type": "column", "settings": { "glyph_asset": "fa-glyph-columns-jing.png", "color": "#2b4795", "title": "Jing · essence" } },
        { "type": "column", "settings": { "glyph_asset": "fa-glyph-columns-qi.png", "color": "#922039", "title": "Qi · vitality" } },
        { "type": "column", "settings": { "glyph_asset": "fa-glyph-columns-shen.png", "color": "#61603a", "title": "Shen · spirit", "width": 368 } }
      ]
    }
  ]
}
{% endschema %}
