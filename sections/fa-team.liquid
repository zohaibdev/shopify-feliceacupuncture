{%- comment -%}
  Felice team — practitioner cards: portrait with an overlapping garnet info panel. Two layouts (setting "Layout"):
  - classic (V4 homepage): centred heading; panel with name, role, arrow and social icons.
    Figma: desktop 414:416 (background), 414:773 (content), 414:872 (botanical); mobile 414:1007, 414:1246.
  - booking (V5 homepage "Your care team"): heading + intro on the left, a button on the right; centred panel with
    name, social icons, specialties and a per-member button. Figma (file B4QcctWXiG9ywP3uRA3coG): desktop 2612:3240
    (background), 2615:10072 (content), 2612:3700 (botanical). No mobile frame: V4 mobile card row + mobile patterns.
  Tablet (900–1099): the same row of four. Mobile (<= 899): horizontal swipe row.
{%- endcomment -%}
{{ 'fa-team.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign layout = section.settings.layout | default: 'classic'
  assign botanical_position = section.settings.botanical_position | default: 'top'
  assign bg_asset = section.settings.background_asset | strip
  assign bg_height = 843
  if bg_asset == blank
    assign bg_asset = 'fa-team-bg.jpg'
  elsif bg_asset == 'fa-team-bg-care.jpg'
    assign bg_height = 951
  endif
  assign section_classes = 'fa-section fa-section--pad fa-team'
  if section.settings.mobile_layout == 'stack'
    assign section_classes = section_classes | append: ' fa-team--mobile-stack'
  endif
  if layout == 'booking'
    assign section_classes = section_classes | append: ' fa-team--booking'
  endif
  if section.settings.show_botanical and botanical_position == 'bottom'
    assign section_classes = section_classes | append: ' fa-team--flower-bottom'
  endif
  assign has_heading = false
  if section.settings.heading != blank or section.settings.text != blank
    assign has_heading = true
  endif
  assign has_button = false
  if layout == 'booking' and section.settings.button_label != blank
    assign has_button = true
  endif
-%}

<section class="{{ section_classes }}" id="fa-team-{{ section.id }}" style="--fa-team-pad-m: {{ section.settings.padding_mobile | default: 50 }}px;"{% if section.settings.heading != blank %} aria-labelledby="fa-team-title-{{ section.id }}"{% endif %}>
  <div class="fa-bg" aria-hidden="true">
    <picture>
      <source media="(max-width: 899px)" srcset="{{ 'fa-team-bg-mobile.jpg' | asset_url }}" width="750" height="1226">
      <img src="{{ bg_asset | asset_url }}" alt="" width="1440" height="{{ bg_height }}" loading="lazy">
    </picture>
  </div>

  {%- if section.settings.show_botanical -%}
    {%- if botanical_position == 'bottom' -%}
      <img class="fa-deco fa-team__flower fa-team__flower--bottom" src="{{ 'fa-first-visit-botanical.png' | asset_url }}" alt="" aria-hidden="true" width="544" height="852" loading="lazy">
    {%- else -%}
      <img class="fa-deco fa-team__flower" src="{{ 'fa-team-flower.png' | asset_url }}" alt="" aria-hidden="true" width="802" height="512" loading="lazy">
    {%- endif -%}
  {%- endif -%}

  <div class="fa-container fa-team__inner">
    {%- if has_heading or has_button -%}
      {%- if layout == 'booking' -%}<div class="fa-team__head">{%- endif -%}
        {%- if has_heading -%}
          <div class="fa-heading fa-team__heading" data-fa-reveal="up" data-fa-reveal-stagger>
            {%- if section.settings.heading != blank -%}
              <h2 class="fa-heading__title" id="fa-team-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if section.settings.text != blank -%}
              <div class="fa-heading__text">{{ section.settings.text }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if has_button -%}
          <div class="fa-team__action" data-fa-reveal="up">
            <a class="fa-btn fa-btn--primary" href="{{ section.settings.button_link | default: '#' }}"{% render 'fa-link-target', url: section.settings.button_link %}>{{ section.settings.button_label | escape }}</a>
          </div>
        {%- endif -%}
      {%- if layout == 'booking' -%}</div>{%- endif -%}
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="fa-team__list{% unless section.settings.mobile_layout == 'stack' %} fa-swipe{% endunless %}" role="list" data-fa-reveal="up" data-fa-reveal-stagger>
        {%- for block in section.blocks -%}
          {%- assign name = block.settings.name | escape -%}
          <li class="fa-team__item" {{ block.shopify_attributes }}>
            <article class="fa-team__card">
              <div class="fa-team__media fa-media">
                {%- if block.settings.image != blank -%}
                  {%- liquid
                    assign image_alt = block.settings.image.alt | default: block.settings.name
                    assign focal = block.settings.image.presentation.focal_point | default: 'center'
                    assign focal_style = '--fa-team-focal: ' | append: focal
                  -%}
                  {{ block.settings.image | image_url: width: 960 | image_tag: widths: '259, 326, 480, 652, 960', sizes: '(min-width: 1100px) calc((min(100vw, 1440px) - 136px) / 4), (min-width: 900px) calc((100vw - 100px) / 4), 259px', loading: 'lazy', alt: image_alt, style: focal_style }}
                {%- elsif block.settings.fallback_asset != blank -%}
                  <img src="{{ block.settings.fallback_asset | asset_url }}" alt="{{ name }}" width="652" height="856" loading="lazy">
                {%- endif -%}
              </div>

              {%- if layout == 'booking' -%}
                {%- comment -%} V5 2612:3608: name, icons, specialties, button in one centred column. {%- endcomment -%}
                <div class="fa-team__panel">
                  {%- if name != blank -%}
                    <h3 class="fa-team__name">
                      <a class="fa-team__link" href="{{ block.settings.link | default: '#' }}"{% render 'fa-link-target', url: block.settings.link %}>{{ name }}</a>
                    </h3>
                  {%- endif -%}
                  {% render 'fa-team-social', block: block, name: name, layout: layout %}
                  {%- if block.settings.role != blank -%}
                    <p class="fa-team__role">{{ block.settings.role | escape }}</p>
                  {%- endif -%}
                  {%- if block.settings.button_label != blank -%}
                    <div class="fa-team__cta">
                      <a class="fa-btn fa-team__btn fa-team__btn--{{ block.settings.button_style | default: 'outline' }}" href="{{ block.settings.button_link | default: '#' }}"{% render 'fa-link-target', url: block.settings.button_link %}>{{ block.settings.button_label | escape }}</a>
                    </div>
                  {%- endif -%}
                </div>
              {%- else -%}
                <div class="fa-team__panel">
                  <div class="fa-team__info">
                    {%- if name != blank -%}
                      <h3 class="fa-team__name">
                        <a class="fa-team__link" href="{{ block.settings.link | default: '#' }}"{% render 'fa-link-target', url: block.settings.link %}>{{ name }}</a>
                      </h3>
                    {%- endif -%}
                    {%- if block.settings.role != blank -%}
                      <p class="fa-team__role">{{ block.settings.role | escape }}</p>
                    {%- endif -%}
                  </div>

                  <span class="fa-team__arrow" aria-hidden="true">{% render 'fa-icon', icon: 'chevron' %}</span>

                  {%- comment -%}
                    Figma draws Instagram, Facebook and X on every card, so all three always render (fa-team-social:
                    a link when the URL is known, Instagram falling back to the practice account, else a decorative span).
                  {%- endcomment -%}
                  {% render 'fa-team-social', block: block, name: name, layout: layout %}
                </div>
              {%- endif -%}
            </article>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Felice team",
  "tag": "div",
  "class": "fa-team-section",
  "settings": [
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Cards on mobile",
      "options": [
        { "value": "swipe", "label": "Swipe row" },
        { "value": "stack", "label": "Stacked, full width" }
      ],
      "default": "swipe"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "classic", "label": "Centred heading, cards with arrow" },
        { "value": "booking", "label": "Heading with button, cards with booking buttons" }
      ],
      "default": "classic"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our team"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Our practitioners offer diverse specialties and treatment styles root in TCM. We focus on understanding the deeper patterns that affect your well-being, rather than just treating your symptoms.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View services",
      "info": "Layout \"Heading with button\" only: shown beside the heading (below the cards on mobile). Leave blank to hide."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "background_asset",
      "label": "Bundled desktop background file",
      "info": "Theme asset behind the section from 900px up. Blank = fa-team-bg.jpg; the V5 homepage uses fa-team-bg-care.jpg."
    },
    {
      "type": "checkbox",
      "id": "show_botanical",
      "label": "Show botanical illustration",
      "default": true
    },
    {
      "type": "select",
      "id": "botanical_position",
      "label": "Botanical position",
      "options": [
        { "value": "top", "label": "Top right" },
        { "value": "bottom", "label": "Bottom right, over the next section" }
      ],
      "default": "top"
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Top and bottom padding (mobile)",
      "min": 40,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 50,
      "info": "Up to 899px (homepage V4: 60)."
    }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Team member",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Portrait",
          "info": "Shown at 326 x 428 (portrait 3:4). Set a focal point to control the crop."
        },
        {
          "type": "text",
          "id": "fallback_asset",
          "label": "Bundled image file",
          "info": "Theme asset used when no image is selected."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Dr. Felice Chan"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role or specialties",
          "default": "Founder · DACM, LAc"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Profile link",
          "info": "The whole card links here."
        },
        {
          "type": "header",
          "content": "Button",
          "info": "Layout \"Heading with button\" only. Leave the label blank to hide the button."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            { "value": "outline", "label": "Outline" },
            { "value": "solid", "label": "Solid" }
          ],
          "default": "outline"
        },
        {
          "type": "header",
          "content": "Social links",
          "info": "Instagram and Facebook always show, as in the design (X too in the centred layout); each links only when filled in, Instagram and Facebook fall back to the practice accounts. Substack shows when filled in."
        },
        {
          "type": "url",
          "id": "instagram",
          "label": "Instagram"
        },
        {
          "type": "url",
          "id": "facebook",
          "label": "Facebook"
        },
        {
          "type": "url",
          "id": "x",
          "label": "X (Twitter)"
        },
        {
          "type": "url",
          "id": "substack",
          "label": "Substack"
        },
        {
          "type": "url",
          "id": "tiktok",
          "label": "TikTok"
        },
        {
          "type": "url",
          "id": "blog",
          "label": "Blog"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Felice team",
      "blocks": [
        {
          "type": "member",
          "settings": {
            "fallback_asset": "fa-team-felice-chan.jpg",
            "name": "Dr. Felice Chan",
            "role": "Founder · DACM, LAc"
          }
        },
        {
          "type": "member",
          "settings": {
            "fallback_asset": "fa-team-sarah-viducic.jpg",
            "name": "Dr. Sarah Viducic",
            "role": "Nervous system regulation, digestive support, hormonal balance"
          }
        },
        {
          "type": "member",
          "settings": {
            "fallback_asset": "fa-team-sam-audette.jpg",
            "name": "Dr. Sam Audette",
            "role": "Immune and auto-immune support, pain management, sports medicine"
          }
        },
        {
          "type": "member",
          "settings": {
            "fallback_asset": "fa-team-caroline-kirk.jpg",
            "name": "Caroline Kirk",
            "role": "Women's health, hormonal balance, fertility support"
          }
        }
      ]
    },
    {
      "name": "Felice care team",
      "settings": {
        "layout": "booking",
        "heading": "Your care team",
        "text": "<p>Our practitioners offer diverse specialties and treatment styles rooted in TCM. We focus on understanding the deeper patterns that affect your well-being, rather than just treating your symptoms.</p>",
        "background_asset": "fa-team-bg-care.jpg",
        "botanical_position": "bottom"
      },
      "blocks": [
        {
          "type": "member",
          "settings": {
            "fallback_asset": "fa-team-felice-chan.jpg",
            "name": "Dr. Felice Chan",
            "role": "Gut Health · Nervous System Imbalance · Mental Health · Women's Health · Pain Management · Chronic Inflammation · Cosmetic Acupuncture",
            "button_label": "Join the waitlist",
            "button_style": "solid"
          }
        },
        {
          "type": "member",
