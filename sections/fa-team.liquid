            "fallback_asset": "fa-team-sam-audette.jpg",
            "name": "Dr. Sam Audette",
            "role": "Nervous System Health · Sports Medicine · Pain Management · Immune + Autoimmune Support · Nutrition Support · Cosmetic Acupuncture",
            "button_label": "Book with Dr. Sam"
          }
        },
        {
          "type": "member",
