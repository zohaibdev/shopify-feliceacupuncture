            "button_label": "Book with Caroline"
          }
        },
        {
          "type": "member",
          "settings": {
            "fallback_asset": "fa-team-sarah-viducic.jpg",
            "name": "Dr. Sarah Viducic",
            "role": "Menstrual Irregularity · Gynecological Conditions · Hormonal Imbalance · Fertility Support · Nutrition Support · Cosmetic Acupuncture",
            "button_label": "Book with Dr. Sarah"
          }
        }
      ]
    }
  ]
}
{% endschema %}
