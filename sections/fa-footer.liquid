{%- comment -%}
  Felice footer — logo, social, newsletter, link columns and bottom bar.
  Figma: lower part of desktop group 414:875 (414:914 main row, 414:966 bottom bar);
  mobile 414:1499 + 414:1543 + 414:1555 inside 414:1462.
  Shares the paper texture with fa-book-visit: the footer pins the lower half of the Figma texture to its top
  edge, fa-book-visit pins the upper half to its bottom edge, so there is no seam when they are stacked.
  Link columns are "Link column" blocks: pick a menu (Online Store → Navigation), or — while no menu is
  chosen — the block's "Links" list (one "Label | URL" per line) is used, so the default footer matches Figma.
  V5 ("Footer Web" 2620:10864 desktop, "Footer mobile" 2519:4184): logo row (seal beside the name, stacked on
  mobile), Facebook + Instagram, "Join the TCM collective"; on mobile (≤899) the link columns are an accordion.
  The accordion buttons only collapse anything once scripts run (CSS `scripting: enabled`); the inline script
  below is delegated on document, so it survives Theme Editor section reloads.
{%- endcomment -%}
{{ 'fa-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign terms_url = section.settings.terms_link
  if shop.terms_of_service.url != blank
    assign terms_url = shop.terms_of_service.url
  endif
  assign privacy_url = section.settings.privacy_link
  if shop.privacy_policy.url != blank
    assign privacy_url = shop.privacy_policy.url
  endif
  assign social_networks = 'facebook,instagram' | split: ','
  if section.settings.show_tiktok or section.settings.tiktok_url != blank
    assign social_networks = 'facebook,instagram,tiktok' | split: ','
  endif
-%}

<footer class="fa-section fa-footer">
  <div class="fa-bg fa-footer__bg" aria-hidden="true">
    <picture>
      <source media="(max-width: 1099px)" srcset="{{ 'fa-footer-bg-mobile.jpg' | asset_url }}" width="750" height="2018">
      <img src="{{ 'fa-footer-bg.jpg' | asset_url }}" alt="" width="1440" height="571" loading="lazy">
    </picture>
  </div>

  <div class="fa-container fa-footer__main">
    <div class="fa-footer__brand" data-fa-reveal="fade">
      <div class="fa-footer__identity">
        <a href="{{ routes.root_url }}" class="fa-footer__logo">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 640 | image_tag: widths: '320, 640', sizes: '320px', alt: shop.name, loading: 'lazy', class: 'fa-footer__logo-img' }}
          {%- elsif section.settings.logo_layout == 'row' -%}
            {%- comment -%} Figma 2366:514: seal beside the name (363 x 30); mobile keeps the stacked logo (2519:4184). {%- endcomment -%}
            <picture>
              <source media="(max-width: 899px)" srcset="{{ 'fa-footer-logo.png' | asset_url }}" width="640" height="120">
              <img src="{{ 'fa-footer-logo-row.png' | asset_url }}" alt="{{ shop.name }}" width="726" height="60" loading="lazy" class="fa-footer__logo-img fa-footer__logo-img--row">
            </picture>
          {%- else -%}
            <img src="{{ 'fa-footer-logo.png' | asset_url }}" alt="{{ shop.name }}" width="640" height="120" loading="lazy" class="fa-footer__logo-img">
          {%- endif -%}
        </a>

        {%- comment -%} Figma draws Facebook + Instagram (TikTok optional): a network without a URL renders as a non-interactive decoration. {%- endcomment -%}
        <ul class="fa-footer__social" role="list">
          {%- for network in social_networks -%}
            {%- case network -%}
              {%- when 'facebook' -%}
                {%- assign social_url = section.settings.facebook_url -%}
                {%- assign social_label = 'Facebook' -%}
              {%- when 'instagram' -%}
                {%- assign social_url = section.settings.instagram_url -%}
                {%- assign social_label = 'Instagram' -%}
              {%- else -%}
                {%- assign social_url = section.settings.tiktok_url -%}
                {%- assign social_label = 'TikTok' -%}
            {%- endcase -%}
            {%- if social_url != blank -%}
              <li><a href="{{ social_url }}" class="fa-footer__social-item"{% render 'fa-link-target', url: social_url %} aria-label="{{ social_label }}">{% render 'fa-icons-footer', icon: network %}</a></li>
            {%- else -%}
              <li aria-hidden="true"><span class="fa-footer__social-item" aria-hidden="true">{% render 'fa-icons-footer', icon: network %}</span></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      {%- if section.settings.newsletter_enable -%}
        <div class="fa-footer__newsletter">
          <div class="fa-footer__newsletter-copy">
            {%- if section.settings.newsletter_heading != blank -%}
              <h2 class="fa-footer__newsletter-title">{{ section.settings.newsletter_heading | escape }}</h2>
            {%- endif -%}
            {%- if section.settings.newsletter_text != blank -%}
              <p class="fa-footer__newsletter-text">{{ section.settings.newsletter_text | escape }}</p>
            {%- endif -%}
          </div>

          {%- form 'customer', id: 'FaFooterNewsletter', class: 'fa-footer__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="fa-footer__field">
              <label class="fa-visually-hidden" for="FaFooterNewsletter-email">{{ 'newsletter.label' | t }}</label>
              <input
                id="FaFooterNewsletter-email"
                class="fa-footer__input"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="{{ section.settings.newsletter_placeholder | default: 'Email address' | escape }}"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                aria-required="true"
                required
                {% if form.errors %}
                  autofocus
                  aria-invalid="true"
                  aria-describedby="FaFooterNewsletter-error"
                {% elsif form.posted_successfully? %}
                  aria-describedby="FaFooterNewsletter-success"
                {% endif %}
              >
              {%- if section.settings.newsletter_button_label != blank -%}
                {%- comment -%} Figma V6 2669:25939: "Join now" + a small chevron at the right end of the field. {%- endcomment -%}
                <button type="submit" class="fa-footer__submit fa-footer__submit--label" name="commit">
                  <span class="fa-footer__submit-label">{{ section.settings.newsletter_button_label | escape }}</span>
                  {%- render 'fa-icons-footer', icon: 'chevron-md' -%}
                </button>
              {%- else -%}
                <button type="submit" class="fa-footer__submit" name="commit" aria-label="{{ 'newsletter.button_label' | t }}">
                  <span class="fa-hide-mobile">{% render 'fa-icons-footer', icon: 'chevron-lg' %}</span>
                  <span class="fa-hide-desktop">{% render 'fa-icons-footer', icon: 'chevron-md' %}</span>
                </button>
              {%- endif -%}
            </div>
            {%- if form.errors -%}
              <p class="fa-footer__message fa-footer__message--error" id="FaFooterNewsletter-error">
                {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
              </p>
            {%- endif -%}
            {%- if form.posted_successfully? -%}
              <p class="fa-footer__message" id="FaFooterNewsletter-success" tabindex="-1" autofocus>{{ 'newsletter.success' | t }}</p>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <nav class="fa-footer__nav" data-fa-reveal="fade" data-fa-reveal-stagger aria-label="{{ section.settings.nav_label | default: 'Footer' | escape }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign collapsible = false
            if block.settings.heading != blank
              assign collapsible = true
            endif
          -%}
          <div class="fa-footer__column{% if collapsible and block.settings.open_mobile == false %} is-collapsed{% endif %}" {{ block.shopify_attributes }}>
            {%- if collapsible -%}
              {%- comment -%} Desktop / tablet show the plain heading; mobile (≤899, with scripts) the accordion button. {%- endcomment -%}
              <h2 class="fa-footer__column-title">
                <span class="fa-footer__column-label">{{ block.settings.heading | escape }}</span>
                <button type="button" class="fa-footer__toggle" aria-expanded="{% if block.settings.open_mobile %}true{% else %}false{% endif %}" aria-controls="FaFooterLinks-{{ block.id }}">
                  <span class="fa-footer__toggle-label">{{ block.settings.heading | escape }}</span>
                  {%- render 'fa-icons-footer', icon: 'chevron-acc' -%}
                </button>
              </h2>
            {%- endif -%}
            <ul class="fa-footer__links" id="FaFooterLinks-{{ block.id }}" role="list">
              {%- if block.settings.menu != blank and block.settings.menu.links.size > 0 -%}
                {%- for link in block.settings.menu.links -%}
                  {%- comment -%} Menu links saved with a "?view=" template suffix: the pages render their template without it. {%- endcomment -%}
                  {%- assign link_url = link.url | split: '?view=' | first -%}
                  <li><a href="{{ link_url }}"{% render 'fa-link-target', url: link_url %}{% if link.active %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
                {%- endfor -%}
              {%- else -%}
                {%- assign lines = block.settings.links | newline_to_br | split: '<br />' -%}
                {%- for line in lines -%}
                  {%- assign parts = line | split: '|' -%}
                  {%- assign label = parts[0] | strip -%}
                  {%- if label != blank -%}
                    {%- assign url = parts[1] | strip | default: '#' -%}
                    <li><a href="{{ url }}"{% render 'fa-link-target', url: url %}>{{ label | escape }}</a></li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </ul>
          </div>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>

  <div class="fa-footer__bar">
    <div class="fa-footer__bar-inner">
      {%- if section.settings.copyright != blank -%}
        <p class="fa-footer__copyright">{{ section.settings.copyright | escape }}</p>
      {%- endif -%}
      {%- if section.settings.terms_label != blank or section.settings.privacy_label != blank -%}
        <ul class="fa-footer__policies" role="list">
          {%- if section.settings.terms_label != blank -%}
            <li><a href="{{ terms_url | default: '#' }}"{% render 'fa-link-target', url: terms_url %}>{{ section.settings.terms_label | escape }}</a></li>
          {%- endif -%}
          {%- if section.settings.privacy_label != blank -%}
            <li><a href="{{ privacy_url | default: '#' }}"{% render 'fa-link-target', url: privacy_url %}>{{ section.settings.privacy_label | escape }}</a></li>
          {%- endif -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{%- if section.blocks.size > 0 -%}
  <script>
    (function () {
      if (window.faFooterAccordion) return;
      window.faFooterAccordion = true;
      function setOpen(column, open) {
        var toggle = column && column.querySelector('.fa-footer__toggle');
        if (!toggle) return;
        column.classList.toggle('is-collapsed', !open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      }
      document.addEventListener('click', function (event) {
        var toggle = event.target.closest && event.target.closest('.fa-footer__toggle');
        if (!toggle) return;
        setOpen(toggle.closest('.fa-footer__column'), toggle.getAttribute('aria-expanded') !== 'true');
      });
      document.addEventListener('shopify:block:select', function (event) {
        setOpen(event.target.closest && event.target.closest('.fa-footer__column'), true);
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Felice footer",
  "tag": "div",
  "class": "fa-footer-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Defaults to the bundled seal + wordmark. Shown 320px wide (267px on mobile)."
    },
    {
      "type": "select",
      "id": "logo_layout",
      "label": "Bundled logo layout",
      "info": "Used while no logo image is chosen.",
      "options": [
        { "value": "row", "label": "Seal beside the name (stacked on mobile)" },
        { "value": "stacked", "label": "Seal above the name" }
      ],
      "default": "row"
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "paragraph",
      "content": "Facebook and Instagram are always shown, as in the design. Icons without a link are decorative (not clickable)."
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok",
      "info": "The TikTok icon is shown when this link is set or the box below is ticked."
    },
    {
      "type": "checkbox",
      "id": "show_tiktok",
      "label": "Show TikTok icon without a link",
      "default": false
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "label": "Show newsletter sign-up",
      "info": "Subscribers are added to Customers with the tag \"newsletter\".",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Join the TCM Collective"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Text",
      "default": "Drop your email, and we'll send you everything you need to know about TCM tips, rituals, and more."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email field placeholder",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "newsletter_button_label",
      "label": "Submit button label",
      "info": "Shown with a small arrow inside the field. Blank shows the large arrow only."
    },
    {
      "type": "text",
      "id": "nav_label",
      "label": "Link columns accessible name",
      "default": "Footer"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright text",
      "default": "© 2026-2027 All Rights Reserved Yandara"
    },
    {
      "type": "text",
      "id": "terms_label",
      "label": "Terms label",
      "default": "Terms & Conditions"
    },
    {
      "type": "url",
      "id": "terms_link",
      "label": "Terms link",
      "info": "Used only when no Terms of service policy is set in Settings → Policies."
    },
    {
      "type": "text",
      "id": "privacy_label",
      "label": "Privacy label",
      "default": "Privacy Policy"
    },
    {
      "type": "url",
      "id": "privacy_link",
      "label": "Privacy link",
      "info": "Used only when no Privacy policy is set in Settings → Policies."
    }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Explore"
        },
        {
          "type": "checkbox",
          "id": "open_mobile",
          "label": "Expanded by default on mobile",
          "info": "On phones the link columns fold into an accordion.",
          "default": false
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "When a menu is chosen it replaces the links below."
        },
        {
          "type": "textarea",
          "id": "links",
          "label": "Links",
          "info": "Used while no menu is chosen. One link per line: Label | URL (URL optional).",
          "default": "Our Approach | #\nServices | #\nOur Team | #\nWhat We Treat | #\nConcierge Care | #\nFAQs | #"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Felice footer",
      "blocks": [
        {
          "type": "links",
          "settings": {
            "heading": "Explore",
            "open_mobile": true,
            "links": "Our Approach | #\nServices | #\nOur Team | #\nWhat We Treat | #\nConcierge Care | #\nFAQs | #"
          }
        },
        {
          "type": "links",
          "settings": {
            "heading": "Visit",
            "links": "Book an Appointment | #\nNew Patients | #\nLocation & Directions | #\nContact Us | #"
          }
        },
        {
          "type": "links",
          "settings": {
            "heading": "Learn",
            "links": "Education | #\nBlog | #\nResources | #\nTraditional Chinese Medicine | #\nNewsletter | #"
          }
        }
      ]
    }
  ]
}
{% endschema %}
