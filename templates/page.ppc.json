    "faq": {
      "type": "fa-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "What happens during my first visit?",
            "answer": "<p>Your initial visit is 75 minutes. Before your appointment, you'll complete an intake form. Together, you and your practitioner will review it and talk through your symptoms, followed by a tongue and pulse diagnostic and your first acupuncture treatment. You'll leave with a personalized treatment plan.</p>",
            "open": false,
            "open_mobile": false
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Does acupuncture hurt?",
            "answer": "<p>Most patients find acupuncture surprisingly gentle. You may feel a brief sensation as the needles are placed, followed by warmth, heaviness, tingling, or deep relaxation.</p>",
            "open": false,
            "open_mobile": false
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "How many sessions will I need?",
            "answer": "<p>It depends on your goals and history. Your practitioner will recommend a treatment plan after your first visit.</p>",
            "open": false,
            "open_mobile": false
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "When will I see results?",
            "answer": "<p>Many patients notice a change within the first few sessions; long-standing concerns usually take longer. Your practitioner will review your progress with you at each visit.</p>",
            "open": false,
            "open_mobile": false
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "How will I feel after my first session?",
            "answer": "<p>Most people feel calm and relaxed, sometimes a little tired. Drink water, rest if you can, and tell your practitioner how you felt at your next visit.</p>",
            "open": false,
            "open_mobile": false
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "What should I wear to my appointment?",
            "answer": "",
            "open": false,
            "open_mobile": false
          }
        },
        "question_7": {
          "type": "question",
          "settings": {
            "question": "How much does a visit cost?",
            "answer": "<p>Prices depend on the treatment and session length. See our services page for current prices, or contact us with any questions.</p>",
            "open": false,
            "open_mobile": false
          }
        },
        "question_8": {
          "type": "question",
          "settings": {
            "question": "Do you take insurance?",
            "answer": "<p>Please contact us before your visit to discuss insurance and payment options.</p>",
            "open": false,
            "open_mobile": false
          }
        },
        "question_9": {
          "type": "question",
          "settings": {
            "question": "Which practitioner should I book?",
            "answer": "<p>Every practitioner treats a wide range of concerns. If you're unsure, contact us and we'll help you choose the best fit.</p>",
            "open": false,
            "open_mobile": false
          }
        },
        "question_10": {
          "type": "question",
          "settings": {
            "question": "Do you offer care at home or virtually?",
            "answer": "<p>Yes. Concierge in-home visits and virtual consultations are available by appointment — contact us to check availability in your area.</p>",
            "open": false,
            "open_mobile": false
          }
        },
        "question_11": {
          "type": "question",
          "settings": {
            "question": "What is your cancellation policy?",
            "answer": "<p>Please let us know as early as possible if you need to cancel or reschedule. Contact us for the full policy.</p>",
            "open": false,
            "open_mobile": false
          }
        }
      },
